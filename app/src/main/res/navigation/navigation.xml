<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/homeFragment">


    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.my.project.authenticator.ui.fragments.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_settingScreen"
            app:destination="@id/settingScreen"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/settingScreen"
        android:name="com.example.my.project.authenticator.ui.fragments.SettingScreen"
        android:label="fragment_setting_screen"
        tools:layout="@layout/fragment_setting_screen">
        <action
            android:id="@+id/action_settingScreen_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
</navigation>