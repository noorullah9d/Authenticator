<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/homeFragment">


    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.my.project.authenticator.ui.fragments.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_backupFragment"
            app:destination="@id/backupFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingScreen"
        android:name="com.example.my.project.authenticator.ui.fragments.SettingScreen"
        android:label="fragment_setting_screen"
        tools:layout="@layout/fragment_setting_screen">
        <action
            android:id="@+id/action_settingScreen_to_themesFragment"
            app:destination="@id/themesFragment" />
        <action
            android:id="@+id/action_settingScreen_to_backupFragment"
            app:destination="@id/backupFragment" />
        <action
            android:id="@+id/action_settingScreen_to_setPasswordFragment"
            app:destination="@id/setPasswordFragment" />
        <action
            android:id="@+id/action_settingScreen_to_userGuideFragment"
            app:destination="@id/userGuideFragment" />
    </fragment>
    <fragment
        android:id="@+id/themesFragment"
        android:name="com.example.my.project.authenticator.ui.fragments.ThemesFragment"
        android:label="fragment_themes"
        tools:layout="@layout/fragment_themes" />
    <fragment
        android:id="@+id/backupFragment"
        android:name="com.example.my.project.authenticator.ui.fragments.BackupFragment"
        android:label="fragment_backup"
        tools:layout="@layout/fragment_backup" />
    <fragment
        android:id="@+id/setPasswordFragment"
        android:name="com.example.my.project.authenticator.ui.fragments.SetPasswordFragment"
        android:label="fragment_set_password"
        tools:layout="@layout/fragment_set_password" />
    <fragment
        android:id="@+id/userGuideFragment"
        android:name="com.example.my.project.authenticator.ui.fragments.UserGuideFragment"
        android:label="fragment_user_guide"
        tools:layout="@layout/fragment_user_guide" >
        <action
            android:id="@+id/action_userGuideFragment_to_guideDetailsFragment"
            app:destination="@id/guideDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/guideDetailsFragment"
        android:name="com.example.my.project.authenticator.ui.fragments.GuideDetailsFragment"
        android:label="fragment_guide_details"
        tools:layout="@layout/fragment_guide_details" >
        <argument
            android:name="url"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/vaultFragment"
        android:name="com.example.my.project.authenticator.ui.fragments.VaultFragment"
        android:label=""
        tools:layout="@layout/fragment_vault" />
    <fragment
        android:id="@+id/addPasswordFragment"
        android:name="com.example.my.project.authenticator.ui.fragments.AddPasswordFragment"
        android:label=""
        tools:layout="@layout/fragment_add_password" />
    <fragment
        android:id="@+id/viewPasswordFragment"
        android:name="com.example.my.project.authenticator.ui.fragments.ViewPasswordFragment"
        android:label=""
        tools:layout="@layout/fragment_view_password" />
</navigation>