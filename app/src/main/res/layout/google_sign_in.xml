<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/_12sdp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcvTop"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_3sdp"
            app:cardBackgroundColor="#BDBDBD"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintBottom_toTopOf="@+id/btnStartAccount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mcvTop">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/ivLockMode"
                android:layout_width="@dimen/_210sdp"
                android:layout_height="@dimen/_180sdp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/welcome" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:ellipsize="end"
                android:fontFamily="@font/open_sans_bold"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/welcome_to_authenticator"
                android:textColor="@color/n_dark_grey"
                android:textSize="@dimen/_18sdp" />

            <TextView
                android:id="@+id/tvSignIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:ellipsize="end"
                android:fontFamily="@font/open_sans_regular"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/sign_in_to_back_codes"
                android:textAlignment="center"
                android:textColor="@color/n_dark_grey"
                android:textSize="@dimen/_12sdp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartAccount"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:backgroundTint="@color/n_sky_blue"
            android:fontFamily="@font/open_sans_regular"
            android:text="@string/signin_google"
            android:textColor="@color/n_consis_white"
            android:textSize="@dimen/_12ssp"
            app:cornerRadius="@dimen/_20sdp"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="24dp"
            app:iconTint="@null"
            app:layout_constraintBottom_toTopOf="@+id/tvContinueWithoutAccount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvContinueWithoutAccount"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:backgroundTint="@color/n_off_white"
            android:fontFamily="@font/open_sans_semi_bold"
            android:text="@string/not_now"
            android:textColor="@color/n_dark_grey"
            android:textSize="@dimen/_12ssp"
            app:cornerRadius="@dimen/_20sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>