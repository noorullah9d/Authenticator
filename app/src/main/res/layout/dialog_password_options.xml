<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/_10sdp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_12sdp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/anchor"
            android:layout_width="@dimen/_45sdp"
            android:layout_height="@dimen/_3sdp"
            android:layout_gravity="center"
            app:cardBackgroundColor="#BDBDBD"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:baselineAligned="false"
            android:foreground="?selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/_12sdp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profileContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvProfileImage"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/circle_background"
                    android:fontFamily="@font/open_sans_semi_bold"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_16ssp"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="G" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfileImage"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:gravity="center"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_google"
                    android:visibility="invisible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/CircularImageViewStyle"
                    tools:ignore="ContentDescription" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/open_sans_semi_bold"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12ssp"
                    tools:text="Account Name" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvLastModified"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:ellipsize="end"
                    android:fontFamily="@font/open_sans_regular"
                    android:maxLines="1"
                    android:textColor="@color/n_dark_grey"
                    android:textSize="@dimen/_8ssp"
                    tools:text="Last modified 5/6/2025" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:background="?selectableItemBackground"
            android:drawableStart="@drawable/ic_expand"
            android:drawablePadding="@dimen/_8sdp"
            android:drawableTint="@color/n_dark_grey"
            android:fontFamily="@font/open_sans_semi_bold"
            android:gravity="center_vertical"
            android:padding="@dimen/_4sdp"
            android:text="@string/view"
            android:textColor="@color/n_dark_grey"
            android:textSize="@dimen/_11ssp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="?selectableItemBackground"
            android:drawableStart="@drawable/ic_edit"
            android:drawablePadding="@dimen/_8sdp"
            android:drawableTint="@color/n_dark_grey"
            android:fontFamily="@font/open_sans_semi_bold"
            android:gravity="center_vertical"
            android:padding="@dimen/_4sdp"
            android:text="@string/edit"
            android:textColor="@color/n_dark_grey"
            android:textSize="@dimen/_11ssp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvCopyUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="?selectableItemBackground"
            android:drawableStart="@drawable/ic_link"
            android:drawablePadding="@dimen/_8sdp"
            android:drawableTint="@color/n_dark_grey"
            android:fontFamily="@font/open_sans_semi_bold"
            android:gravity="center_vertical"
            android:padding="@dimen/_4sdp"
            android:text="@string/copy_url"
            android:textColor="@color/n_dark_grey"
            android:textSize="@dimen/_11ssp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvCopyUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="?selectableItemBackground"
            android:drawableStart="@drawable/ic_user"
            android:drawablePadding="@dimen/_8sdp"
            android:drawableTint="@color/n_dark_grey"
            android:fontFamily="@font/open_sans_semi_bold"
            android:gravity="center_vertical"
            android:padding="@dimen/_4sdp"
            android:text="@string/copy_username"
            android:textColor="@color/n_dark_grey"
            android:textSize="@dimen/_11ssp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvCopyPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="?selectableItemBackground"
            android:drawableStart="@drawable/ic_key"
            android:drawablePadding="@dimen/_8sdp"
            android:drawableTint="@color/n_dark_grey"
            android:fontFamily="@font/open_sans_semi_bold"
            android:gravity="center_vertical"
            android:padding="@dimen/_4sdp"
            android:text="@string/copy_password"
            android:textColor="@color/n_dark_grey"
            android:textSize="@dimen/_11ssp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="?selectableItemBackground"
            android:drawableStart="@drawable/ic_share"
            android:drawablePadding="@dimen/_8sdp"
            android:drawableTint="@color/n_dark_grey"
            android:fontFamily="@font/open_sans_semi_bold"
            android:gravity="center_vertical"
            android:padding="@dimen/_4sdp"
            android:text="@string/share"
            android:textColor="@color/n_dark_grey"
            android:textSize="@dimen/_11ssp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_8sdp"
            android:background="?selectableItemBackground"
            android:drawableStart="@drawable/ic_delete"
            android:drawablePadding="@dimen/_8sdp"
            android:drawableTint="@color/n_dark_grey"
            android:fontFamily="@font/open_sans_semi_bold"
            android:gravity="center_vertical"
            android:padding="@dimen/_4sdp"
            android:text="@string/delete"
            android:textColor="@color/n_dark_grey"
            android:textSize="@dimen/_11ssp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
