<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activities.SplashScreen">


    <ImageView
        android:id="@+id/ivLockMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_90sdp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/lock_mode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/lato_bold"
        android:text="@string/app_name"
        android:textColor="@color/primary"
        android:textSize="@dimen/_18ssp"
        app:layout_constraintEnd_toEndOf="@+id/ivLockMode"
        app:layout_constraintStart_toStartOf="@+id/ivLockMode"
        app:layout_constraintTop_toBottomOf="@+id/ivLockMode" />


    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="@dimen/_150sdp"
        android:layout_height="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_30sdp"
        android:max="100"
        android:progressDrawable="@drawable/progress_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>