<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">


    <item android:state_checked="true" android:color="@color/n_sky_blue">
        <shape android:shape="rectangle">
            <stroke android:width="0dp" android:color="@color/n_sky_blue" />
            <solid android:color="@color/n_sky_blue" />
            <corners android:radius="100dp" />
            <size android:height="@dimen/_15sdp" />
        </shape>
    </item>

    <item android:state_checked="false" android:color="@color/n_switch_color">
        <shape android:shape="rectangle">
            <stroke android:width="0dp" android:color="@color/n_switch_color" />
            <solid android:color="@color/n_switch_color" />
            <corners android:radius="100dp" />
            <size android:height="@dimen/_15sdp" />
        </shape>
    </item>

</selector>